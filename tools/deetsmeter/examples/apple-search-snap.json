{
  "app": { "attach": "AppleMusic.exe" },
  "steps": [
    { "do": "attach" },
    { "do": "wait_window", "timeout_ms": 2000 },
    { "do": "place", "on": "left", "rect": [20, 40, 1040, 1150] },
    { "do": "wait", "ms": 500 },
    { "do": "focus" },
    { "do": "click", "at": [24, 104], "tag": "open-search" },
    { "do": "wait", "ms": 800 },
    { "do": "text", "text": "Alina Baraz", "every_ms": 60, "tag": "type" },
    { "do": "wait", "ms": 1500 },
    { "do": "snap", "tag": "typed" },
    { "do": "key", "key": "enter", "tag": "enter" },
    { "do": "wait", "ms": 2000 },
    { "do": "snap", "tag": "entered" }
  ]
}
