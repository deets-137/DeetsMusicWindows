{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeetsMusic",
  "mainBinaryName": "DeetsMusic",
  "version": "0.6.1",
  "identifier": "com.deetsmusic.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DeetsMusic",
        "width": 480,
        "height": 864,
        "minWidth": 340,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "dragDropEnabled": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,HardwareMediaKeyHandling --autoplay-policy=no-user-gesture-required"
      },
      {
        "label": "tray",
        "title": "DeetsMusic",
        "url": "tray.html",
        "width": 360,
        "height": 232,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Aditya Sundaram",
    "copyright": "© 2026 Aditya Sundaram",
    "category": "Music",
    "shortDescription": "A lightweight Apple Music player for Windows 11.",
    "longDescription": "A lightweight Apple Music player for Windows 11: frameless midi-player chrome, a bento of swappable cards, and a token-based theme × skin system.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../cli/dist/deetsmusic.exe": "cli/deetsmusic.exe",
      "../extension/manifest.json": "extension/manifest.json",
      "../extension/install.html": "extension/install.html",
      "../extension/README.md": "extension/README.md",
      "../extension/src/": "extension/src/",
      "../extension/popup/": "extension/popup/",
      "../extension/options/": "extension/options/",
      "../extension/styles/": "extension/styles/",
      "../extension/icons/": "extension/icons/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./nsis/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ5Mjc4MzI3RTVFRjUxNzMKUldSelVlL2xKNE1uU2JCVG12VFczOFg1c3Zvdk9wa3ZOOHFZcXp3TmVkbnlxS0Vla3k4WXVYVkgK",
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "deetsmusic"
        ]
      }
    }
  }
}
