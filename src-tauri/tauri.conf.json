{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeetsMusic",
  "mainBinaryName": "DeetsMusic",
  "version": "1.2.1",
  "identifier": "com.deetsmusic.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "DeetsMusic",
        "width": 495,
        "height": 670,
        "minWidth": 385,
        "minHeight": 550,
        "decorations": false,
        "resizable": true,
        "dragDropEnabled": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,HardwareMediaKeyHandling --autoplay-policy=no-user-gesture-required"
      },
      {
        "label": "tray",
        "create": false,
        "title": "DeetsMusic",
        "url": "tray.html",
        "width": 360,
        "height": 232,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": {
        "default-src": "'self'",
        "script-src": ["'self'", "https://js-cdn.music.apple.com"],
        "style-src": "'self'",
        "img-src": ["'self'", "data:", "blob:", "https://*.mzstatic.com", "https://*.blobstore.apple.com","http://cover.localhost", "http://files.localhost", "http://wallpaper.localhost"],
        "media-src": ["'self'", "blob:", "https://*.apple.com"],
        "font-src": ["'self'", "data:"],
        "connect-src": [
          "'self'", "ipc:", "http://ipc.localhost",
          "https://*.apple.com", "https://*.mzstatic.com",
          "http://cover.localhost", "http://files.localhost", "http://wallpaper.localhost",
          "https://rooms.deets.solutions", "wss://rooms.deets.solutions",
          "https://musicfriends.deets.solutions", "wss://musicfriends.deets.solutions"
        ],
        "worker-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Aditya Sundaram",
    "copyright": "© 2026 Aditya Sundaram",
    "category": "Music",
    "shortDescription": "A lightweight Apple Music player for Windows 11.",
    "longDescription": "A lightweight Apple Music player for Windows 11: frameless midi-player chrome, a bento of swappable cards, and a token-based theme × skin system.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../cli/dist/deetsmusic.exe": "cli/deetsmusic.exe",
      "../mcpb/dist/deetsmusic.mcpb": "mcpb/deetsmusic.mcpb"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "deetsmusic"
        ]
      }
    }
  }
}
