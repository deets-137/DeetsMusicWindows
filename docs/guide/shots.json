{
  "about": "The shot list for scripts/shots.mjs (docs/guide/SHOTS.md §3). Every shot runs in every look unless it names `looks` (F1, 2026-09-26).",
  "shots": [
    {
      "id": "midi-home",
      "covers": "features/HOME.md",
      "kind": "picture",
      "source": "demo",
      "size": "midi",
      "steps": [{ "wait": 600 }]
    },
    {
      "id": "max-overview",
      "covers": "architecture/SURFACES-AND-CARDS.md",
      "kind": "picture",
      "source": "demo",
      "size": "max",
      "steps": [{ "wait": 600 }]
    },
    {
      "id": "compass-open",
      "covers": "features/COMPASS.md",
      "kind": "picture",
      "source": "demo",
      "size": "midi",
      "steps": [
        { "key": "Ctrl+Space" },
        { "wait": ".compass__input" },
        { "type": "honey", "delay": 60 },
        { "wait": 500 }
      ]
    },
    {
      "id": "clip-compass-arrive",
      "about": "Ctrl+Space opens the Compass; type a word; Escape closes it.",
      "covers": "features/COMPASS.md",
      "kind": "clip",
      "source": "demo",
      "size": "midi",
      "seconds": 3.5,
      "steps": [
        { "key": "Ctrl+Space" },
        { "wait": 700 },
        { "type": "honey", "delay": 90 },
        { "wait": 700 },
        { "key": "Escape" }
      ]
    },
    {
      "id": "clip-card-swap",
      "about": "Midi: pick Library from the left card's title menu, so Home and Library change places (CARD-SWAP.md, the skin's --swap-* shape).",
      "covers": "cards/CARD-SWAP.md",
      "kind": "clip",
      "source": "demo",
      "size": "midi",
      "seconds": 3,
      "steps": [
        { "click": "[data-slot=\"left\"] .panel__title" },
        { "wait": 500 },
        { "click": "[data-slot=\"left\"] .flyout__item[data-card-id=\"library\"]", "strip": true }
      ]
    }
  ]
}
