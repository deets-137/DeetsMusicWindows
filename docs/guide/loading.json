        { "wait": 2500 },
        { "key": "Escape" }
      ],
      "steps": [{ "click": "[data-slot=\"right\"] [data-idx=\"0\"]", "strip": true, "frames": 240, "region": "[data-slot=\"right\"]" }]
    },
    {
      "id": "load-search",
      "about": "Search: the title menu › Search, then type a word. The results and their covers. The field is found wherever Search lands: an earlier clip can leave the cards in another order (the demo keeps local storage between shots).",
      "covers": "features/SEARCH.md",
      "kind": "clip", "source": "demo", "size": "midi", "seconds": 6,
      "strip": { "seconds": 4, "fps": 15, "cols": 12, "width": 160 },
