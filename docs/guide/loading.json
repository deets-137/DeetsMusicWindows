      "steps": [{ "click": ".np__btn[aria-label=\"Next\"]", "strip": true, "frames": 240, "region": "[data-slot=\"np\"]" }]
    },
    {
      "id": "load-rewind",
      "about": "Rewind: the title menu › Rewind. The stats.",
      "covers": "features/DEETS-REWIND.md",
      "kind": "clip", "source": "demo", "size": "midi", "seconds": 5,
      "strip": { "seconds": 3, "fps": 15, "cols": 12, "width": 160 },
      "steps": [
        { "click": "[data-slot=\"left\"] .panel__title" },
        { "wait": 500 },
        { "click": "[data-slot=\"left\"] .flyout__item[data-card-id=\"rewind\"]", "strip": true, "frames": 240, "region": "[data-slot=\"left\"]" }
      ]
    },
    {
      "id": "load-radio",
      "about": "Radio: the title menu › Radio. The stations.",
      "covers": "features/STATIONS.md",
      "kind": "clip", "source": "demo", "size": "midi", "seconds": 5,
      "strip": { "seconds": 3, "fps": 15, "cols": 12, "width": 160 },
      "steps": [
        { "click": "[data-slot=\"left\"] .panel__title" },
        { "wait": 500 },
        { "click": "[data-slot=\"left\"] .flyout__item[data-card-id=\"radio\"]", "strip": true, "frames": 240, "region": "[data-slot=\"left\"]" }
      ]
    },
    {
      "id": "load-credits",
      "about": "Credits: Ctrl+Space › Song credits for the song in Now Playing. The song pane and its writers.",
      "covers": "features/CREDITS.md",
      "kind": "clip", "source": "demo", "size": "midi", "seconds": 5,
      "strip": { "seconds": 3, "fps": 15, "cols": 12, "width": 160 },
      "prepare": [{ "wait": 2500 }],
      "steps": [
        { "key": "Ctrl+Space" },
        { "wait": ".compass__input" },
