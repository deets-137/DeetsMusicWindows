{
  "about": "The loading set (docs/guide/LOADING-SET.md §3.6): one clip per wait, the demo replaying the owner's real round trips and cover times from latency.json. Each clip opens the card with its real control and keeps the next real paints on the card with its change curve, its pops and its settled time. Run: node scripts/shots.mjs --list docs/guide/loading.json --latency p90 --cold → shots/loading/<version>/. Without --latency the demo answers at once: the same clips are then the 'no wait' baseline.",
  "looks": [{ "theme": "moonlight", "skin": "glass" }, { "theme": "moonlight", "skin": "press" }],
  "shots": [
    {
      "id": "load-home",
      "about": "Home at launch (the left card in Midi): the page loads from nothing, with every command cold.",
      "covers": "features/HOME.md",
      "kind": "clip", "source": "demo", "size": "midi", "seconds": 6,
      "strip": { "seconds": 4, "fps": 15, "cols": 12, "width": 160 },
      "steps": [{ "reload": true, "strip": true, "frames": 240, "region": "[data-slot=\"left\"]" }]
    },
    {
      "id": "load-library",
      "about": "The Library at launch (the right card in Midi): the songs and their covers, every command cold.",
      "covers": "architecture/LIBRARY-VIRTUALIZATION.md",
      "kind": "clip", "source": "demo", "size": "midi", "seconds": 6,
      "strip": { "seconds": 4, "fps": 15, "cols": 12, "width": 160 },
      "steps": [{ "reload": true, "strip": true, "frames": 240, "region": "[data-slot=\"right\"]" }]
    },
    {
      "id": "load-playlists",
      "about": "Playlists, first open: the title menu › Playlists. The list, the sync, the counts, the mosaics (the §1 recording).",
      "covers": "features/PLAYLISTS.md",
      "kind": "clip", "source": "demo", "size": "midi", "seconds": 6,
      "strip": { "seconds": 4, "fps": 15, "cols": 12, "width": 160 },
      "steps": [
        { "click": "[data-slot=\"left\"] .panel__title" },
        { "wait": 500 },
        { "click": "[data-slot=\"left\"] .flyout__item[data-card-id=\"playlists\"]", "strip": true, "frames": 240, "region": "[data-slot=\"left\"]" }
      ]
    },
    {
      "id": "load-playlist",
      "about": "A playlist: a click on the first playlist row. Its songs, the covers, the hero mosaic.",
      "covers": "features/PLAYLISTS.md",
      "kind": "clip", "source": "demo", "size": "midi", "seconds": 5,
      "strip": { "seconds": 3, "fps": 15, "cols": 12, "width": 160 },
      "prepare": [
        { "click": "[data-slot=\"left\"] .panel__title" },
        { "wait": 500 },
        { "click": "[data-slot=\"left\"] .flyout__item[data-card-id=\"playlists\"]" },
        { "wait": 5000 }
      ],
      "steps": [{ "click": "[data-slot=\"left\"] .lib-row", "strip": true, "frames": 240, "region": "[data-slot=\"left\"]" }]
    },
    {
      "id": "load-album",
      "about": "An album: the Library grouped by album, a click on the first one. Its songs and covers.",
      "covers": "architecture/UI-ARCHITECTURE.md",
      "kind": "clip", "source": "demo", "size": "midi", "seconds": 5,
      "strip": { "seconds": 3, "fps": 15, "cols": 12, "width": 160 },
      "prepare": [
        { "wait": 2500 },
        { "click": "[data-slot=\"right\"] .lib-pill[data-pop=\"view\"]" },
        { "wait": 500 },
        { "click": ".lib-pop__opt[data-group=\"albums\"]" },
        { "wait": 2500 },
        { "key": "Escape" }
      ],
      "steps": [{ "click": "[data-slot=\"right\"] [data-idx=\"0\"]", "strip": true, "frames": 240, "region": "[data-slot=\"right\"]" }]
    },
    {
      "id": "load-artist",
      "about": "The artist view: the Library grouped by artist, a click on the first one. The hero photo, the shelves, the Last.fm box.",
      "covers": "features/ARTIST-VIEW.md",
      "kind": "clip", "source": "demo", "size": "midi", "seconds": 6,
      "strip": { "seconds": 4, "fps": 15, "cols": 12, "width": 160 },
      "prepare": [
        { "wait": 2500 },
        { "click": "[data-slot=\"right\"] .lib-pill[data-pop=\"view\"]" },
