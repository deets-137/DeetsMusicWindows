{
  "about": "The same Next, Next, Back, Back as metal-next-back.json, warm: no cache clear, so the covers come from memory (the usual case).",
  "desk_test": "docs/features/metal.md §6.7; DESK-TESTS.md A11",
  "made": "2026-10-20",
  "pass": "Read the two click strips by time as for metal-next-back.json; warm, there is no still moment between the old cover landing and the next one setting off.",
  "run": "node scripts/shots.mjs --list docs/ops/checks/metal-next-back-warm.json",
  "shots": [
    {
      "about": "Metal Next and Back, warm",
      "covers": "docs/features/metal.md",
      "id": "metal-next-back-warm",
      "kind": "clip",
      "source": "dev",
      "size": "max",
      "seconds": 16,
      "steps": [
        {
          "wait": 3500
        },
        {
          "wait": 800
        },
        {
          "probe": "JSON.stringify({title: document.querySelector('.np__title')?.textContent, next: document.querySelector('.metal-peek[data-side=\"next\"]')?.dataset.src?.slice(-30), prev: document.querySelector('.metal-peek[data-side=\"prev\"]')?.dataset.src?.slice(-30)})",
          "name": "before"
        },
        {
          "click": "[data-slot=\"np\"] .np__btn:not(.np__btn--play):last-of-type"
        },
        {
          "wait": 900
        },
        {
          "probe": "JSON.stringify({title: document.querySelector('.np__title')?.textContent, next: document.querySelector('.metal-peek[data-side=\"next\"]')?.dataset.src?.slice(-30), prev: document.querySelector('.metal-peek[data-side=\"prev\"]')?.dataset.src?.slice(-30)})",
          "name": "before"
        },
        {
          "click": "[data-slot=\"np\"] .np__btn:not(.np__btn--play):last-of-type",
          "frames": 50,
          "region": "[data-slot=\"np\"] .np__art"
        },
        {
          "wait": 1000
        },
        {
          "probe": "JSON.stringify({title: document.querySelector('.np__title')?.textContent, next: document.querySelector('.metal-peek[data-side=\"next\"]')?.dataset.src?.slice(-30), prev: document.querySelector('.metal-peek[data-side=\"prev\"]')?.dataset.src?.slice(-30)})",
          "name": "after-next"
        },
        {
          "click": "[data-slot=\"np\"] .np__btn:not(.np__btn--play)",
          "frames": 50,
          "region": "[data-slot=\"np\"] .np__art"
        },
        {
          "wait": 700
        },
        {
          "click": "[data-slot=\"np\"] .np__btn:not(.np__btn--play)"
        },
        {
          "wait": 1200
        },
        {
          "probe": "(() => { const m = window.MusicKit && MusicKit.getInstance(); if (m && m.isPlaying) m.pause(); return JSON.stringify({title: document.querySelector('.np__title')?.textContent, playing: !!(m && m.isPlaying)}); })()",
          "name": "end"
        }
      ]
    }
  ]
}
