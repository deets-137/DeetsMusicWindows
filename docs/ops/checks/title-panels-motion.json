        {
          "wait": 1200
        },
        {
          "probe": "JSON.stringify({ hint: !!document.querySelector('.hint') && getComputedStyle(document.querySelector('.hint')).opacity !== '0' })",
          "expect": {
            "hint": true
          },
          "name": "status hint"
        },
        {
          "eval": "window.__net.speakerPlayed()",
          "frames": 45
        },
        {
          "wait": 900
        },
        {
          "probe": "JSON.stringify({ rows: [...document.querySelectorAll('#net-panel .net__row')].map(r => r.dataset.row), growing: document.getElementById('net-panel').classList.contains('is-growing'), entering: document.querySelectorAll('#net-panel .pop-enter').length })",
          "expect": {
            "rows": [
              "internet",
              "airplay",
              "apple",
              "stream"
            ],
            "growing": false,
            "entering": 0
          },
          "name": "airplay row"
        },
        {
          "click": "#net-panel [data-net-test]",
          "frames": 60
        },
        {
          "wait": 3000
        },
        {
          "probe": "JSON.stringify({ speed: document.querySelector('#net-panel .net__result').textContent, hint: document.querySelector('#net-panel .net__result').dataset.hint, disabled: document.querySelector('[data-net-test]').disabled })",
          "expect": {
            "speed": "/^(Good|OK|Bad)$/",
            "hint": "/Mbps down/",
            "disabled": false
          },
          "name": "test"
        },
        {
          "click": "#net-open",
          "frames": 40
        },
        {
          "wait": 800
        },
        {
          "probe": "JSON.stringify({ shut: document.getElementById('net-panel').hidden, carAnims: document.querySelector('#net-open .net__car').getAnimations().length })",
          "expect": {
            "shut": true,
            "carAnims": 0
          },
          "name": "closed"
        }
      ]
    },
