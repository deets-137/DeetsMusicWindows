{
  "about": "The card grow motion on the running dev app, Max first (his most used surface), for the stress test and the independent design review (CARD-GROW.md §20). The four core Max grows in every skin; then Max's other cases (both directions, a grow that escalates to Fill, a switch to another card's grow, a press outside, the two-column and two-row layouts, reduced motion) in his own look; Midi last. Each clip collapses any grow on screen with no motion first.",
  "desk_test": "cards/CARD-GROW.md §20",
  "made": "2026-10-20",
  "pass": "Each open: the edge you clicked moves, rows show before the edge stops, no empty still card, no snap. Each collapse: shorter, the covered card fades back in its own cell. The probes read grown, then clean (no grow, no leftover class, no clip left on a panel). No gap over ~50 ms in pops mid-motion.",
  "run": "node scripts/shots.mjs --list docs/ops/checks/grow-review.json",
  "shots": [
    {
      "id": "max-wide",
      "about": "Max: the top-left card grows wide over its right neighbor, then Escape.",
      "covers": "cards/CARD-GROW.md",
      "kind": "clip", "source": "dev", "size": "max", "seconds": 3.2,
      "looks": [{ "theme": "moonlight", "skin": "*" }],
      "steps": [
        { "eval": "__grow.state() && __grow.collapse('review')" },
        { "wait": 600 },
        { "hover": "[data-slot=\"left\"] .grow-zone[data-side=\"right\"]" },
        { "wait": 300 },
        { "click": "[data-slot=\"left\"] .grow-zone[data-side=\"right\"]", "frames": 90 },
        { "wait": 1000 },
        { "probe": "JSON.stringify(__grow.state())", "expect": { "slot": "left", "dir": "right" }, "name": "grown" },
        { "key": "Escape", "frames": 70 },
        { "wait": 800 },
        { "probe": "JSON.stringify({ s: __grow.state(), stuck: document.querySelectorAll('.is-covering,.is-uncovering,.is-covered,.is-grow-rebuild,[data-grow]').length, clip: [...document.querySelectorAll('[data-slot]')].filter(e => e.getAnimations().length || e.style.clipPath).length })", "expect": { "s": null, "stuck": 0, "clip": 0 }, "name": "clean" }
      ]
    },
