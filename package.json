{
  "name": "deetsmusic",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "deetsmusic": {
    "updateGroup": 1
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:app": "node scripts/dev-app.mjs",
    "cli:build": "cargo build --release --manifest-path cli/Cargo.toml && node scripts/cli-dist.mjs",
    "release": "node scripts/release.mjs",
    "release:publish": "node scripts/publish-update.mjs",
    "release:check": "node scripts/release-check.mjs",
    "signin:assets": "node scripts/signin-assets.mjs",
    "dev:perf": "node scripts/dev-app.mjs --perf",
    "dev:built": "node scripts/dev-app.mjs --built",
    "bench": "node scripts/bench.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "vite": "^6.0.3",
    "typescript": "~5.6.2"
  }
}
