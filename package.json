{
  "name": "deetsmusic",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "deetsmusic": {
    "updateGroup": 2
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:app": "node scripts/dev-app.mjs",
    "cli:build": "cargo build --release --manifest-path cli/Cargo.toml && node scripts/cli-dist.mjs && node scripts/mcpb-pack.mjs",
    "mcpb:pack": "node scripts/mcpb-pack.mjs",
    "release": "node scripts/release.mjs",
    "release:publish": "node scripts/publish-update.mjs",
    "release:check": "node scripts/release-check.mjs",
    "csp:relax": "node scripts/csp-relax.mjs",
    "tokens": "node scripts/tokens.mjs",
    "happy:art": "node scripts/happy-art.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "latency:profile": "node scripts/latency-profile.mjs",
    "docs:copies": "node scripts/docs-copies.mjs",
    "test": "node --import ./tests/setup.mjs --test \"tests/*.test.ts\"",
    "check": "tsc --noEmit && npm test && npm run docs:check && cargo check --manifest-path src-tauri/Cargo.toml && cargo test --quiet --manifest-path src-tauri/Cargo.toml && cargo test --quiet --manifest-path crates/mcp-install/Cargo.toml && node scripts/storage.mjs --check",
    "storage": "node scripts/storage.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "icons": "python scripts/icons.py",
    "signin:assets": "node scripts/signin-assets.mjs",
    "usage:keys": "node --import ./tests/setup.mjs scripts/usage-keys.mjs",
    "dev:perf": "node scripts/dev-app.mjs --perf",
    "dev:built": "node scripts/dev-app.mjs --built",
    "dev:fresh": "node scripts/dev-app.mjs --fresh",
    "dev:fresh:in": "node scripts/dev-app.mjs --fresh=keep",
    "bench": "node scripts/bench.mjs",
    "demo": "vite --config vite.demo.config.ts",
    "demo:build": "tsc --noEmit -p demo && vite build --config vite.demo.config.ts",
    "demo:publish": "node scripts/demo-publish.mjs",
    "listen": "vite --config vite.listen.config.ts --mode listen",
    "listen:build": "tsc --noEmit -p web && vite build --config vite.listen.config.ts --mode listen"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "vite": "^6.0.3",
    "typescript": "~5.6.2"
  }
}
