{
  "name": "deetsmusic",
  "private": true,
  "version": "0.14.1",
  "type": "module",
  "deetsmusic": {
    "updateGroup": 1
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:app": "node scripts/dev-app.mjs",
    "cli:build": "cargo build --release --manifest-path cli/Cargo.toml && node scripts/cli-dist.mjs",
    "release": "node scripts/release.mjs",
    "release:publish": "node scripts/publish-update.mjs",
    "release:check": "node scripts/release-check.mjs",
    "tokens": "node scripts/tokens.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:copies": "node scripts/docs-copies.mjs",
    "signin:assets": "node scripts/signin-assets.mjs",
    "dev:perf": "node scripts/dev-app.mjs --perf",
    "dev:built": "node scripts/dev-app.mjs --built",
    "dev:fresh": "node scripts/dev-app.mjs --fresh",
    "dev:fresh:in": "node scripts/dev-app.mjs --fresh=keep",
    "bench": "node scripts/bench.mjs",
    "demo": "vite --config vite.demo.config.ts",
    "demo:build": "tsc --noEmit -p demo && vite build --config vite.demo.config.ts",
    "demo:publish": "node scripts/demo-publish.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "vite": "^6.0.3",
    "typescript": "~5.6.2"
  }
}
